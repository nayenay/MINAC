# Credenciales de Firebase Admin SDK (mismo proyecto/base de datos que usa
# apps/server — Realtime Database, no Firestore).
#
# 1. Firebase Console -> ⚙️ Configuración del proyecto -> Cuentas de servicio
#    -> "Generar nueva clave privada". Se descarga un archivo .json.
# 2. Pega el contenido COMPLETO de ese JSON en una sola línea, entre comillas
#    simples, en FIREBASE_SERVICE_ACCOUNT.
# 3. FIREBASE_DATABASE_URL es la URL de tu Realtime Database
#    (Firebase Console -> Realtime Database -> parte superior de la página,
#    algo como https://tu-proyecto-default-rtdb.firebaseio.com/).
#
# Copia este archivo a .env.local y reemplaza los placeholders. .env.local
# nunca se commitea (ver .gitignore).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"TU_PROYECTO","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
FIREBASE_DATABASE_URL=https://TU_PROYECTO-default-rtdb.firebaseio.com/

# Config de Firebase para el NAVEGADOR (SDK cliente), usada solo por la
# pestaña "Burn-in 24h" para escuchar en tiempo real (onValue) el nodo
# laboratorio/burnin/{practica} que sube el ESP32 autónomo por WiFi.
#
# A diferencia de FIREBASE_SERVICE_ACCOUNT (arriba), estos valores NO son
# secretos: Firebase los expone siempre en el bundle del navegador por
# diseño. La seguridad se aplica con las reglas de Realtime Database
# (ver firebase/database.rules.json), no ocultando este config.
#
# Firebase Console -> ⚙️ Configuración del proyecto -> Tus apps -> Web ->
# "Configuración del SDK" (o crea una app web si no existe ninguna).
NEXT_PUBLIC_FIREBASE_API_KEY=TU_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://TU_PROYECTO-default-rtdb.firebaseio.com/
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TU_PROYECTO
